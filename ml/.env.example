ML_API_HOST=0.0.0.0
ML_API_PORT=8000
MODEL_PATH=models/
DATA_PATH=data/
CACHE_PATH=data/cache/
REGISTRY_PATH=models/registry/

# Get your free API keys at:
# Football: https://www.football-data.org/client/register
# Odds: https://the-odds-api.com/
# Basketball: https://www.balldontlie.io/

FOOTBALL_DATA_API_KEY=
ODDS_API_KEY=
BASKETBALL_API_KEY=

# Path to backend Prisma SQLite database for direct training data
BACKEND_DB_PATH=../backend/prisma/betting.db

# Model training
N_FOLDS=5
CV_STRATEGY=time_series
TEST_SIZE=0.15
VAL_SIZE=0.10
OPTUNA_TRIALS=50
OPTUNA_TIMEOUT=3600
MIN_TRAINING_SAMPLES=500
RETRAIN_FREQUENCY_DAYS=7
