generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./betting.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  predictions     UserPrediction[]
  preferences     UserPreference?
  gamblingLimit   GamblingLimit?
  bettingSessions BettingSession[]

  @@map("users")
}

model UserPreference {
  id                String @id @default(uuid())
  userId            String @unique @map("user_id")
  notificationLevel String @default("all") @map("notification_level")
  defaultLeague     String? @map("default_league")
  theme             String @default("dark")

  favoriteLeagues   String? @map("favorite_leagues")
  favoriteTeams     String? @map("favorite_teams")
  preferredBetTypes String? @map("preferred_bet_types")
  riskTolerance     String @default("medium") @map("risk_tolerance")
  maxStake          Float? @map("max_stake")
  monthlyBudget     Float? @map("monthly_budget")
  maxDailyBets      Int? @map("max_daily_bets")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model GamblingLimit {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  dailyLossLimit    Float?    @map("daily_loss_limit")
  weeklyLossLimit   Float?    @map("weekly_loss_limit")
  monthlyDepositLimit Float?  @map("monthly_deposit_limit")
  maxStakePerBet    Float?    @map("max_stake_per_bet")
  coolOffUntil      DateTime? @map("cool_off_until")
  selfExcluded      Boolean   @default(false) @map("self_excluded")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gambling_limits")
}

model BettingSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  startTime  DateTime  @map("start_time")
  endTime    DateTime? @map("end_time")
  betsPlaced Int       @default(0) @map("bets_placed")
  totalStake Float     @default(0) @map("total_stake")
  netProfit  Float     @default(0) @map("net_profit")
  status     String    @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("betting_sessions")
}

model League {
  id      String @id
  name    String
  country String
  logo    String?
  sport   String @default("football")

  matches Match[]

  @@map("leagues")
}

model Team {
  id      String @id
  name    String
  short   String?
  logo    String?

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  @@map("teams")
}

model Match {
  id           String   @id @default(uuid())
  externalId   String?  @unique @map("external_id")
  leagueId     String   @map("league_id")
  homeTeamId   String   @map("home_team_id")
  awayTeamId   String   @map("away_team_id")
  homeScore    Int?     @map("home_score")
  awayScore    Int?     @map("away_score")
  status       String   @default("SCHEDULED")
  kickoff      DateTime
  season       String?
  matchday     Int?
  createdAt    DateTime @default(now()) @map("created_at")

  league    League @relation(fields: [leagueId], references: [id])
  homeTeam  Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam  Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  predictions UserPrediction[]
  odds        MatchOdds?
  aiPrediction AiPrediction?

  @@map("matches")
}

model MatchOdds {
  id        String  @id @default(uuid())
  matchId   String  @unique @map("match_id")
  homeWin   Float   @map("home_win")
  draw      Float?
  awayWin   Float   @map("away_win")
  overUnder Float?  @map("over_under")
  overPrice Float?  @map("over_price")
  underPrice Float? @map("under_price")
  bttsYes   Float?  @map("btts_yes")
  bttsNo    Float?  @map("btts_no")
  updatedAt DateTime @updatedAt @map("updated_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_odds")
}

model AiPrediction {
  id           String   @id @default(uuid())
  matchId      String   @unique @map("match_id")
  homeWinProb  Float    @map("home_win_prob")
  drawProb     Float?   @map("draw_prob")
  awayWinProb  Float    @map("away_win_prob")
  predictedHomeGoals Float? @map("predicted_home_goals")
  predictedAwayGoals Float? @map("predicted_away_goals")
  confidence   Float
  modelVersion String?  @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("ai_predictions")
}

model UserPrediction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  matchId    String   @map("match_id")
  predictedWinner String @map("predicted_winner")
  confidence Float
  stake      Float?   @default(0)
  odds       Float?   @map("odds_at_time")
  betType    String   @default("moneyline") @map("bet_type")
  spread     Float?   @map("spread")
  overUnder  Float?   @map("over_under")
  result     String?
  profit     Float?
  isResolved Boolean  @default(false) @map("is_resolved")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("user_predictions")
}

model ModelRecord {
  id            String   @id @default(uuid())
  name          String
  version       String
  sport         String
  accuracy      Float?
  logLoss       Float?   @map("log_loss")
  brierScore    Float?   @map("brier_score")
  roi           Float?
  trainingSamples Int?   @map("training_samples")
  isChampion    Boolean  @default(false) @map("is_champion")
  params        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([name, version])
  @@map("model_records")
}

model PredictionCache {
  id        String   @id @default(uuid())
  matchKey  String   @unique @map("match_key")
  result    String
  confidence Float
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("prediction_cache")
}
